{
  "name": "wangchan-dorm",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n wrangler,vite \"wrangler dev --env=''\" \"vite dev\"",
    "predev": "npm run build",
    "build": "vite build",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "deploy": "npm run build && wrangler deploy --env=''",
    "db:migrate:local": "wrangler d1 migrations apply wangchan-dorm --local --env=''",
    "db:migrate:remote": "wrangler d1 migrations apply wangchan-dorm --remote --env=''",
    "db:seed:local": "wrangler d1 execute wangchan-dorm --local --env='' --file seed/rooms.sql && wrangler d1 execute wangchan-dorm --local --env='' --file seed/tenants.sql && wrangler d1 execute wangchan-dorm --local --env='' --file seed/settings.sql",
    "db:seed:remote": "wrangler d1 execute wangchan-dorm --remote --env='' --file seed/rooms.sql && wrangler d1 execute wangchan-dorm --remote --env='' --file seed/tenants.sql && wrangler d1 execute wangchan-dorm --remote --env='' --file seed/settings.sql",
    "rich-menu": "node scripts/rich-menu.mjs",
    "rich-menu:list": "node scripts/rich-menu.mjs --list",
    "rich-menu:delete": "node scripts/rich-menu.mjs --delete"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "hono": "^4.13.7",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "miniflare": "5.20260911.0-alpha"
  }
}
