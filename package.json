{
  "name": "wangchan-dorm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n wrangler,vite \"wrangler dev\" \"vite dev\"",
    "predev": "npm run build",
    "build": "vite build",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply wangchan-dorm --local",
    "db:migrate:remote": "wrangler d1 migrations apply wangchan-dorm --remote",
    "db:seed:local": "wrangler d1 execute wangchan-dorm --local --file seed/rooms.sql && wrangler d1 execute wangchan-dorm --local --file seed/tenants.sql && wrangler d1 execute wangchan-dorm --local --file seed/settings.sql",
    "db:seed:remote": "wrangler d1 execute wangchan-dorm --remote --file seed/rooms.sql && wrangler d1 execute wangchan-dorm --remote --file seed/tenants.sql && wrangler d1 execute wangchan-dorm --remote --file seed/settings.sql"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "miniflare": "5.20260911.0-alpha"
  }
}
