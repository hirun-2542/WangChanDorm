# ไฟล์ตัวอย่างสำหรับพัฒนาในเครื่อง คัดลอกเป็น .dev.vars แล้วใส่ค่าจริง (ห้าม commit .dev.vars)

# โทเคนสำหรับเรียก LINE Messaging API ได้จาก LINE Developers Console
LINE_CHANNEL_ACCESS_TOKEN=

# รหัสลับสำหรับตรวจลายเซ็น webhook ที่ LINE ส่งเข้ามา
LINE_CHANNEL_SECRET=

# คีย์และรหัสสาขาสำหรับตรวจสลิปโอนเงินผ่าน SlipOK
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# LIFF ID ของแอปลงทะเบียนผู้เช่า สร้างใน LINE Developers Console (ขนาด Full, scope profile)
# แล้วใส่ค่าที่นี่ ปล่อยว่างได้จนกว่าจะสร้างแอป — หน้าลงทะเบียนจะแจ้งให้เปิดจากในแอป LINE จนกว่าจะตั้งค่า
LIFF_ID=

# รหัสลับของ Google OAuth client (ชนิด Web application) สำหรับปุ่ม "เข้าสู่ระบบด้วย Google"
#
# สร้างใน Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# แล้วเพิ่ม Authorized redirect URI ให้ครบทั้งสองแบบ:
#   http://localhost:5173/api/auth/google/callback          (ตอน dev)
#   https://wangchan-dorm.nodhk2545.workers.dev/api/auth/google/callback   (ตอน production)
#
# ถ้าเว้นว่าง ปุ่ม Google จะขึ้นว่า "ยังไม่ได้เปิดใช้ Google" ส่วนการล็อกอิน
# ด้วยอีเมลและรหัสผ่านยังใช้ได้ตามปกติ
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# หมายเหตุ: OWNER_EMAIL ไม่ใช่ secret จึงตั้งใน `vars` ของ wrangler.jsonc
# ไม่ต้องใส่ในไฟล์นี้
#
# หมายเหตุ: DORM_SHEET_ID (ใช้กับ scripts/import-dorm-sheet.mjs เท่านั้น ไม่ใช่ของแอป)
# ไม่ได้อยู่ในไฟล์นี้เพราะ `wrangler types` จะประกาศทุกคีย์ใน .dev.vars เป็น binding
# ของ Worker — ตั้งค่าด้วย environment variable หรือไฟล์ scripts/.dorm-sheet.env แทน
