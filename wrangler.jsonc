{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wangchan-dorm",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SEAM_PROBE": "0",

    // ปิดเป็นค่าเริ่มต้นเสมอบน production — เปิดเฉพาะบน config ของ Worker เดโม
    // (wangchan-demo) เท่านั้น ใช้รูปแบบตรวจค่าตรงตัวแบบเดียวกับ SEAM_PROBE
    "DEMO_MODE": "0",
    "LIFF_ID": "2010453783-KryBOXrc",

    // อีเมลเจ้าของหอ — คนแรกที่ตั้งบัญชีด้วยอีเมลนี้จะได้รับช่วงครอบครัวเดิม
    // ที่ถือห้อง ผู้เช่า และบิลทั้งหมดอยู่ เป็นค่าธรรมดาไม่ใช่ secret
    "OWNER_EMAIL": "nodhk2545@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wangchan-dorm",
      "database_id": "985296cf-2b88-4f8f-b8f8-57e1fb508456",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SLIPS",
      "bucket_name": "wangchan-dorm-slips"
    }
  ],
  // หนึ่ง instance ต่อครอบครัว — ใช้ fan-out ความเปลี่ยนแปลงของบิลไปทุกแท็บเว็บ
  // ที่เปิดค้างอยู่ (ดู src/worker/realtime.ts)
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "FamilyRealtime" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyRealtime"] }],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/webhook/*", "/qr/*", "/slips/*", "/invoices/*", "/register", "/welcome"]
  },
  // สภาพแวดล้อมเดโมสาธารณะ — Worker คนละตัว (wangchan-demo) ฐานข้อมูลและ R2
  // คนละก้อนกับ production โดยสิ้นเชิง (เทียบ id/ชื่อ bucket ด้านล่างกับของ
  // production ด้านบน — ต้องไม่ตรงกันแม้แต่ตัวเดียว) ยังไม่มี route ของเดโมเอง
  // ในตั๋วนี้ (นั่นคืองานของตั๋ว 06) — ตอนนี้รันแอปเดิมทุกอย่างเหมือนเดิม แค่
  // ชี้ไปที่ resource คนละก้อน — vars/bindings ไม่ inherit จาก top-level ตาม
  // ธรรมชาติของ wrangler จึงต้องประกาศครบทุกค่าซ้ำในนี้
  "env": {
    "demo": {
      "name": "wangchan-demo",
      "vars": {
        "SEAM_PROBE": "0",

        // เปิดเสมอบนสภาพแวดล้อมนี้เท่านั้น — เป็นค่าเดียวที่ทำให้ประตู DEMO_MODE
        // ทั่วทั้งระบบเปิด (เส้นทางเข้าเดโม + การ์ดกันส่ง LINE/ตรวจสลิปจริง)
        "DEMO_MODE": "1",
        "LIFF_ID": "",

        // ค่าตัวอย่าง ไม่ใช่อีเมลเจ้าของหอจริง — เดโมไม่ใช้เส้นทาง Google OAuth
        // เดิมในการเข้าระบบ (ตั๋ว 06 มีทางเข้าคลิกเดียวของตัวเอง)
        "OWNER_EMAIL": "demo-owner@example.invalid"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wangchan-demo",
          "database_id": "c89c697e-a991-4a9a-8360-6d3d2d4dc351",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SLIPS",
          "bucket_name": "wangchan-demo-slips"
        }
      ],
      // ต้องประกาศซ้ำที่นี่เสมอ: wrangler env ไม่ inherit binding จาก top-level
      // ถ้าลืม demo worker จะ 500 ตอนเรียก env.REALTIME (WS ต้องใช้ได้ในเดโมด้วย)
      "durable_objects": {
        "bindings": [{ "name": "REALTIME", "class_name": "FamilyRealtime" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyRealtime"] }]
    }
  }
}
